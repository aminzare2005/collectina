# ============================================================================
# collectina — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================================

# PostgreSQL (required)
DATABASE_URL=postgresql://user:password@localhost:5432/collectina
# for supabase you should get connection string URI on transaction pooler method

# Better Auth (required)
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Application (required)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_PHONE_NUMBER=09xxxxxxxxx

# Zibal Payment (required)
ZIBAL_PROXY_URL=https://fetchme.ir/collectina
ZIBAL_PROXY_SECRET=your-proxy-secret

# S3-compatible Storage (required for custom uploads — Liara / ArvanCloud / MinIO)
S3_ENDPOINT=https://s3.ir-thr-at1.arvancloud.ir
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=default
S3_PUBLIC_URL=https://your-bucket.s3.ir-thr-at1.arvancloud.ir
